{
  "name": "@cashop-tech/console-cli",
  "version": "0.1.0-beta.8",
  "description": "Cashop Console CLI & MCP Server",
  "type": "module",
  "bin": {
    "cashop-console": "./dist/cashop-console.js"
  },
  "main": "./dist/cashop-console.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Cashop-Tech/cashop-cli.git",
    "directory": "packages/cli-admin"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cashop-console.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ bin/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cashop/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "nock": "^14.0.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
