    "kleur": "^4.1.5",
    "shell-quote": "^1.8.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/shell-quote": "^1.7.5",
    "msw": "^2.3.5",
    "tsup": "^8.4.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "license": "UNLICENSED",
