{
  "name": "cashop-cli",
  "version": "0.1.4",
  "description": "Cashop-CLI — official command-line interface for the Cashop platform",
  "type": "module",
  "bin": {
    "cashop-cli": "./dist/entry.js",
    "cashop": "./dist/entry.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
