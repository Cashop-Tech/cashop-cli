{
  "name": "cashop-cli",
  "version": "0.1.0-dev",
  "description": "Cashop-CLI — official command-line interface for the Cashop platform",
  "type": "module",
  "bin": {
    "cashop-cli": "./dist/entry.js",
    "cashop": "./dist/entry.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tsx src/entry.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "keytar": "^7.9.0",
    "cli-table3": "^0.6.5",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5",
    "msw": "^2.3.5"
  },
  "license": "UNLICENSED",
  "private": true
}
