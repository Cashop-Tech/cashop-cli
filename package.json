{
  "name": "cashop-workspace",
  "private": true,
  "description": "Cashop CLI monorepo (cli-c consumer CLI + cli-admin operations CLI + shared core)",
  "type": "module",
  "packageManager": "pnpm@10.13.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=!cashop-workspace build",
    "typecheck": "pnpm -r --filter=!cashop-workspace typecheck",
    "test": "pnpm -r --filter=!cashop-workspace test",
    "build:core": "pnpm --filter @cashop/core build",
    "build:c": "pnpm --filter cashop-cli build",
    "build:admin": "pnpm --filter @cashop-tech/console-cli build",
    "dev:c": "pnpm --filter cashop-cli dev",
    "dev:admin": "pnpm --filter @cashop-tech/console-cli dev"
  },
  "license": "UNLICENSED"
}
